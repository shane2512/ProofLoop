# Placeholders only. Copy to .env and edit. Never commit .env.
# Do not put Kane/TestMu credentials here; use `kane-cli login`.

# Private writable app data directory (database, run output, evidence).
PROOFLOOP_DATA_DIR=./data

# Managed root for _test.md files (must be inside the data directory in Phase 2+).
PROOFLOOP_TESTS_DIR=./data/tests

# Evidence import/copy root (used only after Kane evidence behavior is validated).
PROOFLOOP_EVIDENCE_DIR=./data/evidence

# Optional trusted path to the Kane executable. Leave empty to use PATH.
KANE_CLI_PATH=

# ProofLoop run timeout policy in seconds (bounds enforced in code).
KANE_TIMEOUT_SECONDS=300

# Loopback only by default. Must match the host/port in the npm scripts.
PROOFLOOP_HOST=127.0.0.1
PROOFLOOP_PORT=3000
